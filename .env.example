DJANGO_SECRET_KEY= # Preencha com uma chave gerada localmente; não compartilhe.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY_SSL_HEADER=True
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SERVE_MEDIA_FILES=False
MELHOR_ENVIO_SIMULATE_FREIGHT=False

# MySQL local (exemplo acadêmico — cada um pode alterar a senha)
MYSQL_DATABASE=patchworks
MYSQL_USER=patchworks
MYSQL_PASSWORD=patchworks123
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Origem dos envios — fallback se o Admin ainda não tiver Configuração da loja
# Preferência: editar em /admin/ → Configuração da loja (CEP + endereço)
STORE_CEP=07094000
STORE_ADDRESS=Av. Dr. Timoteo Penteado, 1874 - Vila Hulda, Guarulhos - SP

# Melhor Envio — cada integrante cria o PROPRIO app na Area Dev (sandbox)
# Nao compartilhe CLIENT_SECRET nem melhorenvio_token.json no Git
# Callback HTTPS via cloudflared — ver docs/PASSO_A_PASSO_CLOUDFLARED.md
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_USER_AGENT=Patch Works e Afins (seu-email@exemplo.com)
MELHOR_ENVIO_BASE_URL=https://sandbox.melhorenvio.com.br
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_REDIRECT_URI=https://SEU-SUBDOMINIO.trycloudflare.com/api/melhorenvio/callback/
